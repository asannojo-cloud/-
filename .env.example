# PostgreSQL 접속 정보
DATABASE_URL=postgresql://asgongno_app:CHANGE_ME@localhost:5432/asgongno_membercard

# 세션 서명 비밀키 (32바이트 이상 임의 문자열)
SESSION_SECRET=CHANGE_ME

# 서버 포트
PORT=4000
NODE_ENV=development

# 프론트엔드 오리진 (CORS 허용)
FRONTEND_ORIGIN=http://localhost:5173

# 로그인 실패 잠금 정책
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# 사진 저장 경로 (웹 루트 밖)
PHOTO_STORAGE_DIR=./storage/photos

# Excel/ZIP 업로드 임시 디렉터리
UPLOAD_TMP_DIR=./tmp/uploads

# 업로드 용량 제한 (bytes)
MAX_EXCEL_SIZE=10485760
MAX_ZIP_SIZE=209715200
MAX_PHOTO_SIZE=5242880
